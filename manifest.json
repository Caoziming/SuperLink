{
  "manifest_version": 3,
  "name": "Super Link",
  "short_name": "SuperLink",
  "version": "1.15.1",
  "description": "功能强大的书签工具 · 一站式管理你的书签",
  "permissions": ["bookmarks", "sidePanel", "contextMenus", "favicon", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Super Link",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
